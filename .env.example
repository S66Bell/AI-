# ── JARVIS configuration ──────────────────────────────────────────────
# Copy this file to `.env` and adjust as needed.

# Which brain drives JARVIS:
#   llamacpp — llama.cpp's llama-server, or any OpenAI-compatible server
#              (LM Studio, vLLM, Hugging Face TGI). This is what runs on a
#              phone in Termux. Free, offline, no API key.
#   groq     — Groq's cloud API: very fast, free tier, needs a key from
#              console.groq.com. Tools still run on this device.
#   ollama   — a free model running locally via Ollama (default on a PC).
#   claude   — Anthropic's Claude API (requires ANTHROPIC_API_KEY, paid).
JARVIS_PROVIDER=ollama

# ── llama.cpp / OpenAI-compatible server (JARVIS_PROVIDER=llamacpp) ───
# On Android: scripts/termux/start.sh starts llama-server on this address.
JARVIS_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# "local" means "whatever the server is serving"; set a name for multi-model servers.
JARVIS_OPENAI_MODEL=local
JARVIS_OPENAI_API_KEY=no-key

# ── Groq (JARVIS_PROVIDER=groq) ───────────────────────────────────────
# Free key: https://console.groq.com  →  bash scripts/brain.sh groq gsk_...
JARVIS_GROQ_API_KEY=
# llama-3.3-70b-versatile (smart) · llama-3.1-8b-instant (fastest, bigger free quota)
JARVIS_GROQ_MODEL=llama-3.3-70b-versatile

# ── Web UI / phone (python -m jarvis web) ─────────────────────────────
# 127.0.0.1 = only this device. Use 0.0.0.0 to reach it from other devices
# on your network — and then set a token so nobody else can use it.
JARVIS_WEB_HOST=127.0.0.1
JARVIS_WEB_PORT=8765
JARVIS_WEB_TOKEN=

# ── Agent mode (background tasks) ─────────────────────────────────────
# Max tool calls per background task before it is asked to wrap up.
JARVIS_AGENT_MAX_STEPS=40
# Run one self-check pass comparing the report with the goal (costs a call).
JARVIS_AGENT_SELF_CHECK=1
# Let background tasks run risky shell commands without asking (default: declined).
JARVIS_AGENT_ALLOW_DANGEROUS=0

# ── Local model (when JARVIS_PROVIDER=ollama) ─────────────────────────
# Install Ollama from https://ollama.com, then: ollama pull qwen2.5:7b
# Good tool-calling models for ~16GB RAM: qwen2.5:7b, llama3.1:8b
# Smaller (≤8GB RAM): qwen2.5:3b, llama3.2:3b
JARVIS_OLLAMA_MODEL=qwen2.5:7b
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_NUM_CTX=8192

# ── Claude (when JARVIS_PROVIDER=claude) ──────────────────────────────
ANTHROPIC_API_KEY=
# claude-opus-4-8 (capable) · claude-fable-5 (most capable) · claude-sonnet-4-6 (fast)
JARVIS_MODEL=claude-opus-4-8
JARVIS_EFFORT=high

# ── Personality & behaviour (both providers) ──────────────────────────
# Your name or nickname — MIRA calls you by it (leave empty and she'll ask).
JARVIS_USER_NAME=
JARVIS_NAME=MIRA

# Where conversation history and long-term memory are stored.
JARVIS_DATA_DIR=~/.jarvis

# Show a summary of JARVIS's reasoning before it answers.
JARVIS_SHOW_THINKING=0

# Confirm before running ANY shell command (0 = only risky ones).
JARVIS_CONFIRM_ALL_SHELL=0

# Start in voice mode (requires requirements-voice.txt installed).
JARVIS_VOICE=0

# ── Learning (memory) ─────────────────────────────────────────────────
# After every N chat turns, extract durable facts about you from the
# conversation into long-term memory, and fold old history into a summary.
JARVIS_LEARN=1
JARVIS_LEARN_EVERY=6
# Learning only runs once the conversation has been quiet this long (seconds),
# so it never delays a reply or evicts the chat from the model's cache.
JARVIS_LEARN_IDLE=180

# ── Speed ─────────────────────────────────────────────────────────────
# Past turns replayed into the prompt at startup. Smaller = faster first
# reply on a phone; the rolling summary keeps the older context.
JARVIS_HISTORY_TURNS=16
