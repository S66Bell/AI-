# ── JARVIS configuration ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Model to drive the assistant.
#   claude-opus-4-8  — most capable Opus-tier model (default, recommended)
#   claude-fable-5   — Anthropic's most capable model, for the hardest work
#   claude-sonnet-4-6 — faster / cheaper, great for everyday use
JARVIS_MODEL=claude-opus-4-8

# How hard the model thinks before acting: low | medium | high | xhigh | max
JARVIS_EFFORT=high

# What the assistant calls you, and what you call it.
JARVIS_USER_NAME=Sir
JARVIS_NAME=JARVIS

# Where conversation history and long-term memory are stored.
JARVIS_DATA_DIR=~/.jarvis

# Set to 1 to let JARVIS show a summary of its reasoning before answering.
JARVIS_SHOW_THINKING=0

# Set to 1 to require confirmation before running ANY shell command.
# Set to 0 to only confirm commands flagged as potentially destructive.
JARVIS_CONFIRM_ALL_SHELL=0

# Set to 1 to start in voice mode (requires requirements-voice.txt installed).
JARVIS_VOICE=0
