# ── Mira configuration ────────────────────────────────────────────────
# Copy this file to `.env` and adjust as needed.
# (The env var prefix stays `JARVIS_` for compatibility — the assistant is Mira.)

# Which brain drives Mira:
#   ollama  — a free model running locally on your machine (default).
#             No API key, no usage fees, works offline. Needs Ollama installed.
#   hf      — a model served by Hugging Face Inference (needs HF_TOKEN). No
#             local GPU; good for cloud/Spaces. See DEPLOY_HF.md.
#   claude  — Anthropic's Claude API (requires ANTHROPIC_API_KEY, paid).
JARVIS_PROVIDER=ollama

# ── Local model (when JARVIS_PROVIDER=ollama) ─────────────────────────
# Install Ollama from https://ollama.com, then: ollama pull qwen2.5:7b
# Tool-capable (Mira can run shell/files/web): qwen2.5 and llama3.1/3.2.
#   ~16GB RAM: qwen2.5:7b, llama3.1:8b   ·   ≤8GB RAM: qwen2.5:3b, llama3.2:3b
# Chat-only alt (no tools): gemma3:4b / gemma3:12b — Mira falls back cleanly.
JARVIS_OLLAMA_MODEL=qwen2.5:7b
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_NUM_CTX=8192

# ── Hugging Face Inference (when JARVIS_PROVIDER=hf) ───────────────────
# Token from https://huggingface.co/settings/tokens (HF_TOKEN also works).
HF_TOKEN=
# Any served, tool-capable model id, e.g. Qwen/Qwen2.5-7B-Instruct,
# meta-llama/Llama-3.1-8B-Instruct. Non-tool models fall back to chat-only.
JARVIS_HF_MODEL=Qwen/Qwen2.5-7B-Instruct
JARVIS_HF_BASE_URL=https://router.huggingface.co/v1

# ── Free persistence (optional) ───────────────────────────────────────
# Snapshot conversations + memory to a private HF Dataset so a free Space
# survives restarts. Needs a *write* token (HF_TOKEN works, or set
# JARVIS_HF_DATA_TOKEN). Leave JARVIS_HF_DATASET empty to disable.
JARVIS_HF_DATASET=
# JARVIS_HF_DATA_TOKEN=   # defaults to HF_TOKEN if unset

# ── Claude (when JARVIS_PROVIDER=claude) ──────────────────────────────
ANTHROPIC_API_KEY=
# claude-opus-4-8 (capable) · claude-fable-5 (most capable) · claude-sonnet-4-6 (fast)
JARVIS_MODEL=claude-opus-4-8
JARVIS_EFFORT=high

# ── Personality & behaviour (both providers) ──────────────────────────
JARVIS_USER_NAME=Yukiさん
JARVIS_NAME=Mira

# Force a reply language regardless of what the user writes (e.g. 日本語,
# English). Leave blank to let the model mirror the user's language.
JARVIS_LANGUAGE=

# Timezone for every clock Mira shows (IANA name, e.g. Asia/Tokyo, UTC,
# America/New_York). Important on cloud hosts like a Space, which run in UTC.
# Leave blank to use the host's local time.
JARVIS_TIMEZONE=Asia/Tokyo

# Where conversation history and long-term memory are stored.
JARVIS_DATA_DIR=~/.jarvis

# Show a summary of Mira's reasoning before it answers.
JARVIS_SHOW_THINKING=0

# Confirm before running ANY shell command (0 = only risky ones).
JARVIS_CONFIRM_ALL_SHELL=0

# Start in voice mode (requires requirements-voice.txt installed).
JARVIS_VOICE=0

# ── Google Calendar (optional secretary feature) ──────────────────────
# Lets Mira read your agenda and create/change events. Uses a Google service
# account (no interactive login), so it works on a headless Space.
# Setup (one time):
#   1. Google Cloud → new project → enable the Google Calendar API.
#   2. Create a service account → create a JSON key → download it.
#   3. In Google Calendar → Settings → "Share with specific people", add the
#      service account's email (…@….iam.gserviceaccount.com) with
#      "Make changes to events".
#   4. Copy that calendar's ID (Calendar settings → "Integrate calendar").
# Then set the two vars below. Leave CREDENTIALS blank to disable calendar.
# CREDENTIALS accepts the JSON key inline (paste the whole thing) OR a file path.
JARVIS_GCAL_CREDENTIALS=
# The calendar to use. "primary" is the service account's OWN (empty) calendar —
# set this to the ID of the calendar you shared in step 3/4.
JARVIS_GCAL_ID=primary

# ── Web search (optional but recommended on a Space) ──────────────────
# web_search uses keyless DuckDuckGo by default, but cloud hosts (a Space) are
# usually blocked (HTTP 403). Set ONE free API key for reliable search. Tavily
# is preferred when both are set.
#   Tavily (free tier, made for AI): https://tavily.com → API key
#   Brave Search (free tier):        https://brave.com/search/api/
JARVIS_TAVILY_API_KEY=
JARVIS_BRAVE_API_KEY=

# ── Generation tuning (optional) ──────────────────────────────────────
# Cap HF reply length so answers aren't cut short (the router default can be
# tiny). Lower the temperature for crisper, more deterministic answers; leave
# it blank to use the provider's default.
JARVIS_HF_MAX_TOKENS=4096
JARVIS_TEMPERATURE=

# ── Proactive briefings via Web Push (optional) ───────────────────────
# Push today's agenda + due reminders to your phone, even when the app is
# closed. Generate a VAPID keypair with `python scripts/gen_vapid.py` and paste
# the output here (both required to enable push). Then enable notifications from
# the app menu. A GitHub Actions cron (.github/workflows/briefing.yml) triggers
# the daily send — see that file for the required SPACE_URL var + token secret.
JARVIS_VAPID_PUBLIC_KEY=
JARVIS_VAPID_PRIVATE_KEY=
JARVIS_VAPID_SUBJECT=mailto:yuuki.s66@gmail.com

# ── Web app (requires requirements-web.txt installed) ────────────────
# Run `python serve.py` — it opens http://localhost:8765 in your browser.
# Binds to localhost by default (this PC only). To also use it from a phone
# on the same Wi-Fi, set JARVIS_WEB_HOST=0.0.0.0 and open the printed LAN URL.
JARVIS_WEB_HOST=127.0.0.1
JARVIS_WEB_PORT=8765
# Strongly recommended before exposing Mira beyond localhost (LAN/tunnel):
# set a token here and enter it in the app's Settings to connect.
JARVIS_WEB_TOKEN=
